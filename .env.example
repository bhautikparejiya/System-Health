# ---------------------------------------------------------------
# HighLevel Marketplace app credentials
# (Marketplace developer portal → your app → Advanced Settings → Auth)
# ---------------------------------------------------------------
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Shared Secret (Advanced Settings → Auth → Shared Secret → Generate).
# Used to decrypt the signed user context inside the Custom Page.
GHL_SHARED_SECRET=
# Optional: your app id. If empty it is derived from GHL_CLIENT_ID (the part before the first "-").
GHL_APP_ID=

# Public URL of this deployment, no trailing slash (e.g. https://ghl-health.vercel.app)
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Secrets you generate yourself (e.g. `openssl rand -hex 32`)
# ---------------------------------------------------------------
# Signs widget sessions and embed keys.
SESSION_SECRET=
# Protects /api/cron/scan. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional: if set, the "Health Check-in" workflow action must send header  x-health-secret: <value>
ACTION_SECRET=

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Postgres connection string (Neon via Vercel Marketplace is free).
# Leave empty locally to use an embedded PGlite database stored in ./.data
DATABASE_URL=

# ---------------------------------------------------------------
# Local testing
# ---------------------------------------------------------------
# true = never call HighLevel; serve realistic fake data and allow "demo login" at /app?demo=1
GHL_MOCK=false
